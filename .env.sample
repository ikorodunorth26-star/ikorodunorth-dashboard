NEXT_PUBLIC_APP_NAME=Ikorodu North LCDA
NEXT_PUBLIC_APP_DESCRIPTION=Staff dashboard for Ikorodu North Local Council Development Area.
NEXT_PUBLIC_HOMEPAGE=https://ikorodunorthlcda.lg.gov.ng
NEXT_PUBLIC_CONTACT_URL=https://ikorodunorthlcda.lg.gov.ng/contact
NEXT_PUBLIC_PRIVACY_URL=https://ikorodunorthlcda.lg.gov.ng/privacy-policy
NEXT_PUBLIC_TERMS_URL=https://ikorodunorthlcda.lg.gov.ng/terms-of-use
# Lime and forest green from the public site.
NEXT_PUBLIC_APP_THEME=#ddeb9d
NEXT_PUBLIC_APP_THEME_TEXT=#173d32
# Leave empty in local dev to use the Next.js /v1 rewrite proxy.
# Set to a full origin (no path) only when calling the API directly.
NEXT_PUBLIC_API_URL=
# Used by next.config.mjs rewrites when NEXT_PUBLIC_API_URL is empty.
API_PROXY_TARGET=http://127.0.0.1:4000
